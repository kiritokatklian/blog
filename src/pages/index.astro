---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import {getCollection} from "astro:content";
import BlogLockup from "../components/BlogLockup.astro";

const posts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="dark">
        <Header />

        <main>
            <h1 class="text-4xl font-bold leading-tight tracking-tight mt-4 mb-6">Latest</h1>

            <section>
                <ul class="grid gap-8">
                    {
                        posts.map((post) => (
                                <BlogLockup post={post} />
                        ))
                    }
                </ul>
            </section>

            <div class="mt-12 flex justify-center">
                <a class="rounded-full border border-white/15 bg-white/5 px-6 py-2.5 text-sm font-medium no-underline" href="/blog">View All</a>
            </div>
        </main>

        <Footer />
    </body>
</html>
