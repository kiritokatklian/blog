---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
    <div class="progressive-blur" aria-hidden="true">
        <div class="layer"></div>
        <div class="layer"></div>
        <div class="layer"></div>
        <div class="layer"></div>
        <div class="layer"></div>
        <div class="layer"></div>
        <div class="layer"></div>
        <div class="surface-tint"></div>
    </div>

    <nav>
        <h2>
            <a href="/">{ SITE_TITLE }</a>
        </h2>

        <div class="internal-links">
            <HeaderLink href="/blog">Blog</HeaderLink>
        </div>
    </nav>
</header>
<style>
    header {
        position: sticky;
        top: 0;
        z-index: 50;
        height: var(--header-height);
        margin: 0;
        padding: 0;
        background: transparent;
    }

    .progressive-blur {
        position: absolute;
        top: 0;
        inset-inline: 0;
        height: var(--header-blur-height);
        z-index: 0;
        pointer-events: none;
    }

    .progressive-blur > div {
        position: absolute;
        inset: 0;
    }

    .progressive-blur > .layer:nth-child(1) {
        backdrop-filter: blur(48px);
        -webkit-backdrop-filter: blur(48px);
        mask: linear-gradient(to bottom, black 0%, black 12.5%, transparent 25%);
        -webkit-mask: linear-gradient(to bottom, black 0%, black 12.5%, transparent 25%);
    }

    .progressive-blur > .layer:nth-child(2) {
        backdrop-filter: blur(32px);
        -webkit-backdrop-filter: blur(32px);
        mask: linear-gradient(to bottom, transparent 0%, black 12.5%, black 25%, transparent 37.5%);
        -webkit-mask: linear-gradient(to bottom, transparent 0%, black 12.5%, black 25%, transparent 37.5%);
    }

    .progressive-blur > .layer:nth-child(3) {
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        mask: linear-gradient(to bottom, transparent 12.5%, black 25%, black 37.5%, transparent 50%);
        -webkit-mask: linear-gradient(to bottom, transparent 12.5%, black 25%, black 37.5%, transparent 50%);
    }

    .progressive-blur > .layer:nth-child(4) {
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        mask: linear-gradient(to bottom, transparent 25%, black 37.5%, black 50%, transparent 62.5%);
        -webkit-mask: linear-gradient(to bottom, transparent 25%, black 37.5%, black 50%, transparent 62.5%);
    }

    .progressive-blur > .layer:nth-child(5) {
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        mask: linear-gradient(to bottom, transparent 37.5%, black 50%, black 62.5%, transparent 75%);
        -webkit-mask: linear-gradient(to bottom, transparent 37.5%, black 50%, black 62.5%, transparent 75%);
    }

    .progressive-blur > .layer:nth-child(6) {
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        mask: linear-gradient(to bottom, transparent 50%, black 62.5%, black 75%, transparent 87.5%);
        -webkit-mask: linear-gradient(to bottom, transparent 50%, black 62.5%, black 75%, transparent 87.5%);
    }

    .progressive-blur > .layer:nth-child(7) {
        backdrop-filter: blur(1px);
        -webkit-backdrop-filter: blur(1px);
        mask: linear-gradient(to bottom, transparent 62.5%, black 75%, black 87.5%, transparent 100%);
        -webkit-mask: linear-gradient(to bottom, transparent 62.5%, black 75%, black 87.5%, transparent 100%);
    }

    .progressive-blur > .surface-tint {
        background: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--background) 55%, transparent) 0%,
            color-mix(in srgb, var(--background) 25%, transparent) 50%,
            transparent 100%
        );
    }

    /* Fallback for browsers without backdrop-filter. */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        header {
            background: var(--background);
        }
        .progressive-blur {
            display: none;
        }
    }

    h2 {
        margin: 0;
        font-size: 1em;
    }

    h2 a,
    h2 a.active {
        text-decoration: none;
    }
    nav {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
        margin-inline: auto;
        max-width: min(var(--content-max-width), calc(100% - 2 * var(--content-gutter)));
        padding-inline: var(--content-gutter);
    }
    nav a {
        padding: 0.75em 0;
        color: var(--text);
        border-bottom: 4px solid transparent;
        text-decoration: none;
    }
    nav a.active {
        text-decoration: none;
        border-bottom-color: var(--accent);
    }
    .social-links,
    .social-links a {
        display: flex;
    }
    @media (max-width: 720px) {
        .social-links {
            display: none;
        }
    }
</style>
